#!/usr/bin/env php
<?php

declare(strict_types = 1);

/**
 * Merge, changelog and downbase GitHub pull-requests.
 *
 * @version 1.6.0
 */

/**
 * Every failure the user is meant to read about. The CLI entry point catches
 * this once and turns it into an exit code, so no code path calls exit().
 */
class ContribMergeException extends RuntimeException
{
}

final class ContribMergeUsageException extends ContribMergeException
{
}

final class ConsoleOutput
{
    /** @var resource */
    private $stdout;

    /** @var resource */
    private $stderr;

    /**
     * @param resource $stdout
     * @param resource $stderr
     */
    public function __construct($stdout, $stderr)
    {
        $this->stdout = $stdout;
        $this->stderr = $stderr;
    }

    public static function create(): self
    {
        return new self(STDOUT, STDERR);
    }

    public function line(string $message = ''): void
    {
        fwrite($this->stdout, $message . PHP_EOL);
    }

    public function error(string $message): void
    {
        fwrite($this->stderr, $message . PHP_EOL);
    }
}

final class ProcessResult
{
    /**
     * @param string[] $command
     */
    public function __construct(
        public readonly array $command,
        public readonly int $exitCode,
        public readonly string $stdout,
        public readonly string $stderr,
    ) {
    }

    public function isOk(): bool
    {
        return $this->exitCode === 0;
    }

    public function commandLine(): string
    {
        return implode(' ', array_map(
            static fn (string $argument): string => preg_match('/^[A-Za-z0-9_@%+=:,.\/-]+$/', $argument) === 1
                ? $argument
                : escapeshellarg($argument),
            $this->command
        ));
    }

    public function failureDetails(): string
    {
        $details = 'Command failed with exit code ' . $this->exitCode . ':' . PHP_EOL . $this->commandLine();
        $stderr = trim($this->stderr);
        $stdout = trim($this->stdout);
        if ($stderr !== '') {
            $details .= PHP_EOL . $stderr;
        } elseif ($stdout !== '') {
            $details .= PHP_EOL . $stdout;
        }

        return $details;
    }
}

interface ProcessRunner
{
    /**
     * Run a command without a shell: the arguments are passed as an argv array,
     * so no branch name, path or URL can ever be interpreted by a shell.
     *
     * @param string[] $command
     */
    public function run(array $command, ?string $cwd = null): ProcessResult;
}

final class SystemProcessRunner implements ProcessRunner
{
    public function run(array $command, ?string $cwd = null): ProcessResult
    {
        if ($command === []) {
            throw new ContribMergeException('Refusing to run an empty command');
        }
        // proc_open wants a list: a caller's array with gaps would silently
        // lose its keys to the child process.
        $command = array_values($command);

        $descriptors = [
            0 => ['file', '/dev/null', 'r'],
            1 => ['pipe', 'w'],
            2 => ['pipe', 'w'],
        ];

        // An explicit environment, so the LC_ALL below is the one git sees.
        $environment = getenv();
        // Git messages and ref output are parsed, so they must not be translated.
        $environment['LC_ALL'] = 'C.UTF-8';

        $process = proc_open($command, $descriptors, $pipes, $cwd, $environment);
        if ($process === false) {
            throw new ContribMergeException('Unable to start: ' . implode(' ', $command));
        }

        $streams = [];
        $buffers = ['out' => '', 'err' => ''];
        if (isset($pipes[1]) && is_resource($pipes[1])) {
            $streams['out'] = $pipes[1];
            stream_set_blocking($pipes[1], false);
        }
        if (isset($pipes[2]) && is_resource($pipes[2])) {
            $streams['err'] = $pipes[2];
            stream_set_blocking($pipes[2], false);
        }

        // Both pipes are drained as they fill: reading one to EOF before the
        // other deadlocks as soon as the second one holds more than the pipe
        // buffer, which `composer install` does easily.
        while ($streams !== []) {
            $read = array_values($streams);
            $write = null;
            $except = null;
            $ready = stream_select($read, $write, $except, 30);
            if ($ready === false) {
                break;
            }
            foreach ($read as $stream) {
                $name = array_search($stream, $streams, true);
                if (! is_string($name)) {
                    continue;
                }
                $chunk = fread($stream, 65536);
                if ($chunk === false) {
                    fclose($stream);
                    unset($streams[$name]);
                    continue;
                }
                if ($chunk === '' && feof($stream)) {
                    fclose($stream);
                    unset($streams[$name]);
                    continue;
                }
                $buffers[$name] .= $chunk;
            }
        }

        $exitCode = proc_close($process);

        return new ProcessResult($command, $exitCode, $buffers['out'], $buffers['err']);
    }
}

final class ExecutableFinder
{
    /**
     * Resolve a binary on PATH. `composer-php7.2` and friends are wrappers that
     * only exist as files in a PATH directory, so the lookup is a pure PATH
     * scan -- no shell, nothing to quote.
     */
    public static function find(string $binary): ?string
    {
        $path = getenv('PATH');
        if (! is_string($path) || $path === '') {
            return null;
        }

        foreach (explode(PATH_SEPARATOR, $path) as $directory) {
            if ($directory === '') {
                continue;
            }
            $candidate = rtrim($directory, DIRECTORY_SEPARATOR) . DIRECTORY_SEPARATOR . $binary;
            if (is_file($candidate) && is_executable($candidate)) {
                return $candidate;
            }
        }

        return null;
    }
}

/**
 * Names that end up as git arguments are validated first: a value starting with
 * a dash, or carrying `..` / `@{` / `//`, is a ref git rejects anyway and a
 * value git could read as an option is worse than a clear refusal.
 */
final class GitRefName
{
    public static function assertValidBranch(string $name): void
    {
        if ($name === ''
            || preg_match('#^[A-Za-z0-9][A-Za-z0-9._/-]*$#', $name) !== 1
            || str_contains($name, '..')
            || str_contains($name, '@{')
            || str_contains($name, '//')
            || str_ends_with($name, '/')
            || str_ends_with($name, '.')
            || str_ends_with($name, '.lock')
        ) {
            throw new ContribMergeException('Refusing to use "' . $name . '" as a branch name.');
        }
    }

    public static function assertValidRemote(string $name): void
    {
        if ($name === ''
            || preg_match('#^[A-Za-z0-9][A-Za-z0-9._-]*$#', $name) !== 1
            || str_ends_with($name, '.')
        ) {
            throw new ContribMergeException('Refusing to use "' . $name . '" as a remote name.');
        }
    }
}

final class RepositorySlug
{
    public function __construct(
        public readonly string $owner,
        public readonly string $repository,
    ) {
    }

    public function __toString(): string
    {
        return $this->owner . '/' . $this->repository;
    }

    /**
     * Read `owner/repository` out of a remote URL: ssh, the scp-like
     * `git@host:owner/repo` form, or https.
     */
    public static function fromRemoteUrl(string $url): ?self
    {
        $url = trim($url);
        if ($url === '') {
            return null;
        }

        $patterns = [
            '#^[a-z][a-z0-9+.-]*://(?:[^/@]+@)?[^/]+/(?<path>.+?)/?$#i',
            '#^(?:[^@/]+@)?[^/:]+:(?<path>.+?)/?$#',
        ];

        foreach ($patterns as $pattern) {
            $matches = [];
            if (preg_match($pattern, $url, $matches) !== 1) {
                continue;
            }
            $path = (string) preg_replace('/\.git$/', '', trim($matches['path'], '/'));
            $parts = explode('/', $path);
            if (count($parts) < 2) {
                continue;
            }
            $repository = array_pop($parts);
            $owner = array_pop($parts);
            if ($owner === '' || $repository === '') {
                continue;
            }

            return new self($owner, $repository);
        }

        return null;
    }
}

