{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "wdes/contrib-merge",
    "description": "A single-file tool to merge, changelog and downbase GitHub pull-requests",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "files": [
            "contrib-merge"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "phpstan": "phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true
    }
}
